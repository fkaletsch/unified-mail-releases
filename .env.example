# Copy to .env — never commit real secrets
#
# Postgres (used by docker-compose.yml). Change BEFORE first start —
# POSTGRES_* is only applied when the DB volume is created.
POSTGRES_USER=um
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_DB=unifiedmail
# Must match the three values above:
UM_DATABASE_URL=postgres://um:change-me-before-first-start@db:5432/unifiedmail?sslmode=disable

UM_HTTP_ADDR=:8080
UM_REDIS_ADDR=redis:6379
UM_PUBLIC_URL=http://localhost:8088
# Generate: openssl rand -hex 16
UM_MASTER_KEY=replace-with-32-hex-chars-here!!
UM_SESSION_TTL_HOURS=720
UM_POLL_INTERVAL_SEC=180
UM_IDLE_ENABLED=true
UM_CACHE_QUOTA_GB=50
UM_BLOB_ROOT=/data/blobs
UM_COOKIE_SECURE=false
UM_WEBAUTHN_RPID=localhost
UM_WEBAUTHN_ORIGIN=http://localhost:8088
UM_GOOGLE_CLIENT_ID=
UM_GOOGLE_CLIENT_SECRET=
UM_MS_CLIENT_ID=
UM_MS_CLIENT_SECRET=
# Optional push:
# UM_FCM_CREDENTIALS_FILE=/run/secrets/firebase-sa.json
# UM_FCM_PROJECT_ID=
